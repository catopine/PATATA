{
    "manifest_version": 3,
    "name": "PATATA",
    "version": "1.1.1",

    "description": "Tag regions easily (hopefully).",

    "icons": 
    {
        "32": "icon.svg",
        "48": "icon.svg",
        "64": "icon.svg"
    },

    "permissions": ["storage", "activeTab", "scripting", "cookies", "tabs"],

    "host_permissions": [
        "*://*.nationstates.net/*"
    ],

    "browser_specific_settings": 
    {
        "gecko": 
        {
            "id": "PATATA@catopine.org",
            "data_collection_permissions": 
            {
                "required": ["none"]
            }
        }
    },

    "sidebar_action": 
    {
        "default_icon": "icon.svg",
        "default_title": "PATATA",
        "default_panel": "tagging.html",
        "open_at_install": false
    },

    "content_scripts": 
    [
        {
            "matches": ["*://*.nationstates.net/*"],
            "js": ["content.js"]
        }
    ]

}